name: Build iOS App

on:
  push:
    branches: [ "main" ]  # يمكنك تغيير main إلى اسم الفرع (Branch) الرئيسي لديك
  pull_request:
    branches: [ "main" ]

jobs:
  build-ios:
    name: Build iOS Release
    runs-on: macos-latest # هذا هو الشرط الأساسي: تشغيل البناء على جهاز Mac سحابي

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # 1. تثبيت بيئة لغة بايثون
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      # 2. تثبيت فلت وبقية الاعتمادات
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install flet

      # 3. تثبيت بيئة Flutter (لأن Flet يعتمد عليها داخلياً لبناء منصات الموبايل)
      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          flutter-version: '3.19.x' # يمكنك اختيار إصدار فلاتر المناسب لمشروعك
          cache: true

      # 4. تشغيل أمر بناء الـ iOS عبر Flet
      # (تأكد من مطابقة اسم ملف الوحدة أو الملف الرئيسي لديك مثل app.py أو main.py)
      - name: Build iOS App (IPA)
        run: |
          flet build ipa --module-name app

      # 5. رفع ملف النتائج (Artifacts) لتتمكن من تحميله بعد انتهاء البناء
      - name: Upload iOS Artifact
        uses: actions/upload-artifact@v4
        with:
          name: ios-release-app
          path: build/ios/ipa/*.ipa  # مسار ملف الـ IPA الناتج